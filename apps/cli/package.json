{
  "name": "promptreel",
  "version": "0.8.0",
  "private": true,
  "description": "Tell stories, frame by frame. Turn your ideas and material into vivid explainer videos with an AI director. Local-first, any model.",
  "license": "AGPL-3.0-only",
  "author": "Sitor Team (https://sitor.ai)",
  "homepage": "https://github.com/sitor-ai/promptreel#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sitor-ai/promptreel.git",
    "directory": "apps/cli"
  },
  "bugs": {
    "url": "https://github.com/sitor-ai/promptreel/issues"
  },
  "keywords": [
    "explainer video",
    "ai video",
    "agent",
    "storyboard",
    "narration",
    "tts",
    "promptreel"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "type": "module",
  "bin": {
    "promptreel": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "dev": "node dist/cli.js"
  },
  "dependencies": {
    "@promptreel/agent": "workspace:*",
    "@promptreel/engine": "workspace:*",
    "@promptreel/models": "workspace:*",
    "@promptreel/voice": "workspace:*",
    "@hono/node-server": "1.19.5",
    "hono": "4.9.12",
    "@promptreel/core": "workspace:*",
    "@promptreel/ui": "workspace:*"
  }
}
